    <string name="colortools_boost_range">Boost Range</string>
    <string name="colortools_boost_hint">Video highlights stop at white, so halation (red glow around bright areas) ends up weak. Highlight boost restores the clipped light (spektrafilm\'s boost): everything brighter than mid grey + protection is lifted smoothly, by at most the boost in stops at the brightest point of the image. Amount strengthens the glow directly.</string>
    <string name="colortools_grain">Grain</string>
    <string name="colortools_sublayers">Sublayers</string>
    <string name="colortools_grain_area">Grain Area (µm²)</string>
    <string name="colortools_grain_blur">Grain Blur (px)</string>
    <string name="colortools_grain_hint">Larger grain = fewer per pixel = coarser (spektrafilm: ≈ 0.1 µm² for ISO 100, 0.4 for ISO 400). Sublayers: each color layer has three grain sizes.</string>
    <string name="colortools_glare">Glare</string>
    <string name="colortools_glare_in_paper">Glare in the paper</string>
    <string name="colortools_glare_amount" formatted="false">Glare Amount (%)</string>
    <string name="colortools_glare_roughness">Glare Roughness</string>
