    <string name="colortools_print_auto_comp">Print auto-compensation</string>
    <string name="colortools_print_auto_comp_on_hint">On (spektrafilm default): printing follows the exposure, so brightness stays put. Exposure changes the negative instead – underexposure gives greyer blacks and slightly more grain, overexposure is barely visible (negative film handles a lot of light).</string>
    <string name="colortools_print_auto_comp_off_hint">Off: exposure makes the image brighter/darker.</string>
    <string name="colortools_print_exposure">Print Exposure</string>
