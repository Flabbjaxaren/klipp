    <string name="colortools_film_effects_from">Grain and halation of</string>
    <string name="colortools_film_effects_from_hint">The stock decides only the grain (size, layers) and how the light spreads in the film – not the colors. Its paper, exposure and color controls are not used.</string>
    <string name="colortools_slide_scanned">Slide film: scanned directly, without paper.</string>
