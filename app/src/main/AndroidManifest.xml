<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- only to download the speech recognition model (automatic captions); the audio never leaves the phone -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- voice-over: record speech directly to an audio track -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <application
        android:allowBackup="true"
        android:largeHeap="true"
        android:label="Klipp"
        android:icon="@drawable/ic_launcher"
        android:roundIcon="@drawable/ic_launcher"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.NoActionBar">
        <!-- Qualcomm's OpenCL driver (Adreno) for speech recognition; optional – without it the CPU is used -->
        <uses-native-library android:name="libOpenCL.so" android:required="false" />
        <!-- performance measurement of the release build (simpleperf, Android Studio's profiler) -->
        <profileable android:shell="true" />
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize|uiMode|locale|density|fontScale|keyboard|navigation|layoutDirection"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
